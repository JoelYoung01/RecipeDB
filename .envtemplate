# =======================================================
#     Needed at Build Time (add to Github Varaibles)
# =======================================================

# Display Name for the app
VITE_APP_TITLE=RecipeDB

# Api Url
VITE_API_URL=http://localhost:8000/api

# Google Auth
VITE_GOOGLE_CLIENT_ID=

# Optional: iOS OAuth client for the RecipeDB iOS app (mobile/).
# When set, the API also accepts Google id_tokens issued to this client.
# GOOGLE_IOS_CLIENT_ID=


# =======================================================
#               Only needed at Runtime
# =======================================================

# Deployment Environment
ENVIRONMENT=development

# Extra allowed CORS origins (comma-separated). Add the Expo web preview
# origin when developing the mobile app against a local backend.
# BACKEND_CORS_ORIGINS=http://localhost:8081

# Secret key
# - Used to generate authentication tokens and HMAC email OTPs
SECRET_KEY=

# Superuser GID
# - The Google ID of the user that can be automatically promoted to superuser.
# - Also attached to the seeded admin password user when present.
SUPERUSER_GID=

# Optional: override seeded local password users (defaults shown)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=adminpass123
# SEED_TEST_EMAIL=test@example.com
# SEED_TEST_PASSWORD=testpass123

# Optional OpenRouter credentials for the meal-plan wizard LLM.
# When unset, the wizard uses a deterministic stub client.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inception/mercury-2

# Cover images for newly generated recipes (meal-plan wizard commit).
# Providers: stub | broke (default, free Openverse CC0/PDM search) | qwen
# IMAGE_GEN_PROVIDER=broke
# OPENVERSE_BASE_URL=https://api.openverse.org/v1
# OPENVERSE_LICENSES=cc0,pdm
# Future paid diffusion (not wired yet):
# DASHSCOPE_API_KEY=
# QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# DASHSCOPE_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Optional SMTP for verification emails (when unset, OTP is logged; in
# development the API also returns `dev_otp` in JSON responses)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=
# EMAILS_FROM_NAME=RecipeDB
