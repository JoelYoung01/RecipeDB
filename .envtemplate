# =======================================================
#     Needed at Build Time (add to Github Varaibles)
# =======================================================

# Display Name for the app
VITE_APP_TITLE=RecipeDB

# Api Url
VITE_API_URL=http://localhost:8000/api

# Deployed app origin used by post-deploy smoke tests (no trailing path)
# APP_URL=https://your-app.example.com

# Google Auth
VITE_GOOGLE_CLIENT_ID=


# =======================================================
#               Only needed at Runtime
# =======================================================

# Deployment Environment
ENVIRONMENT=development

# Secret key
# - Used to generate authentication tokens
SECRET_KEY=

# Superuser GID
# - The Google ID of the user that can be automatically promoted to superuser.
SUPERUSER_GID=